PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Paystack test mode — get your own test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# CORS origin — the client dev server
CLIENT_URL=http://localhost:5173

# Cloudinary — admin product/category image upload. Get these from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In — OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application). Add both your dev
# (http://localhost:5173) and production client URLs under "Authorized JavaScript origins".
# Same value goes in client/.env as VITE_GOOGLE_CLIENT_ID — it's a public identifier, not a secret.
GOOGLE_CLIENT_ID=

# Terminal Africa (T-Ship) — used for international shipping quotes (reaches DHL rates).
# Get a secret key from https://app.terminal.africa after signing up. Without this set,
# international shipping silently falls back to the flat rate set in the admin panel.
TERMINAL_AFRICA_SECRET_KEY=

# Seed script — admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@hadorn.com
SEED_ADMIN_PASSWORD=Hadorn-Admin-2026

# Gmail SMTP — notifies the admin by email when a custom order inquiry is submitted.
# GMAIL_APP_PASSWORD is a 16-character "App Password" from your Google Account
# (Security -> 2-Step Verification -> App Passwords), NOT your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
